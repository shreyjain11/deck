#!/usr/bin/env bash
# rcc-list — list tmux sessions, flag which run Claude Code, refresh SESSIONS.md
set -u
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/rcc-common.sh"

usage() {
  cat <<EOF
rcc-list — list tmux sessions and detect Claude Code, then refresh SESSIONS.md

USAGE:
  rcc-list [--no-refresh]

Shows a table: SESSION | CLAUDE | GOAL-STATUS | GOAL | LAST-ACTIVITY.
Also rewrites $RCC_HOME/SESSIONS.md unless --no-refresh is given.
EOF
}

REFRESH=1
case "${1:-}" in
  -h|--help) usage; exit 0;;
  --no-refresh) REFRESH=0;;
esac

require_mux || exit 127

# gather rows into a temp file: session \t claude \t status \t goal \t activity
ROWS="$(mktemp "${TMPDIR:-/tmp}/rcc.XXXXXX")"
trap 'rm -f "$ROWS"' EXIT

sessions="$(mux_list_sessions)"
if [ -z "$sessions" ]; then
  echo "(no tmux sessions found)"
else
  printf '%s\n' "$sessions" | while IFS= read -r s; do
    [ -n "$s" ] || continue
    claude="no"
    if mux_session_is_claude "$s"; then claude="yes"; fi
    gf="$RCC_GOALS/$s.md"
    status="-"; goal="-"; activity="-"
    if [ -f "$gf" ]; then
      status="$(goal_status "$gf")"; [ -n "$status" ] || status="-"
      goal="$(goal_title "$gf")"; [ -n "$goal" ] || goal="-"
    fi
    lf="$RCC_LOGS/$s.log"
    if [ -f "$lf" ]; then
      activity="$(tail -1 "$lf" | cut -c1-19)"
      [ -n "$activity" ] || activity="-"
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$s" "$claude" "$status" "$goal" "$activity" >> "$ROWS"
  done
fi

# ---- pretty table to stdout -------------------------------------------------
{
  printf 'SESSION\tCLAUDE\tGOAL-STATUS\tGOAL\tLAST-ACTIVITY\n'
  if [ -s "$ROWS" ]; then cat "$ROWS"; fi
} | awk -F'\t' '{
  for(i=1;i<=NF;i++){ w=length($i); if(w>max[i])max[i]=w }
  line[NR]=$0
} END {
  for(r=1;r<=NR;r++){
    n=split(line[r],c,"\t"); out="";
    for(i=1;i<=n;i++){ pad=max[i]-length(c[i]); s=c[i]; while(pad-->0)s=s" "; out=out s "  " }
    print out
    if(r==1){ div=""; for(i=1;i<=n;i++){ k=max[i]; while(k-->0)div=div"-"; div=div"  " } print div }
  }
}'

# ---- refresh SESSIONS.md ----------------------------------------------------
if [ "$REFRESH" -eq 1 ]; then
  md="$RCC_HOME/SESSIONS.md"
  {
    echo "# RCC Sessions"
    echo ""
    echo "_Auto-generated by \`rcc-list\` at $(rcc_ts). Do not edit by hand._"
    echo ""
    echo "| Session | Claude? | Goal status | Goal | Last activity |"
    echo "|---------|---------|-------------|------|---------------|"
    if [ -s "$ROWS" ]; then
      while IFS='	' read -r s claude status goal activity; do
        printf '| %s | %s | %s | %s | %s |\n' "$s" "$claude" "$status" "$goal" "$activity"
      done < "$ROWS"
    else
      echo "| _(none)_ |  |  |  |  |"
    fi
    echo ""
    echo "Goals: \`goals/<session>.md\` · Reviews: \`reviews/\` · Logs: \`logs/<session>.log\`"
  } > "$md"
  echo ""
  echo "Refreshed $md"
fi
